rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /introSlides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /music/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if id == 'activeMusic' || id == 'siteContent' || isAdmin();
      allow write: if isAdmin();
    }

    match /pushTokens/{id} {
      allow read, write: if isAdmin();
    }

    match /pushState/{id} {
      allow read, write: if isAdmin();
    }

    match /teklifler/{id} {
      allow read, write: if isAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if isAdmin();
    }

    match /customers/{id} {
      allow read, write: if isAdmin();
    }

    match /ajanda/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
